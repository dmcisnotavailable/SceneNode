    {
      "start": 7.95,
      "end": 14.95,
      "text": "Jadi hari ini, kita akan memulai tutorial pertama di psychometrik"
    },
    {
      "start": 14.95,
      "end": 17.95,
      "text": "Mereka ada 5 masalah, jadi kita akan melalui setiap masalah dengan cepat"
    },
    {
      "start": 17.95,
      "end": 21.95,
      "text": "Dan kemudian, kita akan bekerja dengan perkembangan untuk mendapat jawapan"
    },
    {
      "start": 21.95,
      "end": 26.95,
      "text": "Jadi tolong berhati-hati dengan bagaimana kita berjumpa"
    },
    {
      "start": 26.95,
      "end": 31.61,
      "text": "Untuk menolong masalah"
    },
    {
      "start": 31.61,
