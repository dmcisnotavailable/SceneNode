      "text": "Mereka mempunyai perkembangan di luar luar"
    },
    {
      "start": 44.08,
      "end": 46.08,
      "text": "Membuat dengan perkembangan di luar luar"
    },
    {
      "start": 46.08,
      "end": 48.08,
      "text": "Di sistem kondisi luar"
    },
    {
      "start": 48.08,
